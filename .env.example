# ============================================================
# Sports2D-Web Environment Configuration
# ============================================================
# Copy this file to .env and adjust the values to your needs.
# Then run: docker compose up -d --build
# ============================================================

# ------------------------------------------------------------------
# Ports
# ------------------------------------------------------------------
# Port on which the web frontend (nginx) will be exposed on the host.
FRONTEND_PORT=5173

# Port on which the FastAPI backend API will be exposed on the host.
BACKEND_PORT=8000

# ------------------------------------------------------------------
# Redis / Celery
# ------------------------------------------------------------------
# Only change these if you use an external Redis instance.
# Internal Docker service name is 'redis' on port 6379.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
